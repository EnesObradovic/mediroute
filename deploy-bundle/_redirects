# Cloudflare Pages — Redirects
# Pretty URLs auto-serves .html files at clean URLs — no 200 rewrites needed for static files
# Only keep 200 rewrites for TEMPLATE-based routes (no individual .html files exist)

# ─────────────────────────────────────────
# 301 REDIRECTS: .html → clean URL
# ─────────────────────────────────────────
/index.html             /             301
/about.html             /about        301
/contact.html           /contact      301
/faq.html               /faq          301
/blog.html              /blog         301
/compare.html           /compare      301
/treatments.html        /treatments   301
/auth.html              /auth         301
/admin.html             /admin        301
/treatment/index.html   /treatments   301
/treatment/contact.html /contact      301
/clinic-detail.html     /             301
/blog/index.html        /blog         301
/blog/auth.html         /auth         301

# ─────────────────────────────────────────
# 200 REWRITES: Template-based routing only
# These routes have NO individual .html files — must rewrite to a shared template
# ─────────────────────────────────────────
/treatment/:slug /treatment.html      200
/clinic/:slug    /clinic-detail.html  200
